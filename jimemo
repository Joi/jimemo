#!/usr/bin/env python3
import sys
sys.dont_write_bytecode = True

# Python floor, checked BEFORE sys.path is touched and before anything from
# the package is imported, so a sub-floor interpreter gets one line and a
# non-zero exit instead of a traceback or -- worse -- a silent run with a
# lint check that reads different markup than the browser does (jimemo#gaga;
# the reasons for each component are in src/jimemo/__init__.py). The literal
# is duplicated from jimemo.PYTHON_FLOOR because this file runs before src/
# is importable; tests/test_python_floor.py pins the two together. Written
# so it cannot itself fail on an old interpreter: no f-strings, str.format
# only, sys as the only import.
#
# DECIDED (jimemo#gaga): this launcher does NOT search PATH for a newer
# python3.13/python3.14 and re-exec into it. install.sh validates the
# python3 it finds on PATH, so one contract -- "the python3 you run jimemo
# with must be at or above the floor" -- holds in both places and needs no
# reconciliation; re-exec would silently substitute an interpreter the user
# did not name; and a patch-level floor makes the search close to useless,
# because `python3.13` on PATH says nothing about whether it is 3.13.3 or
# 3.13.6. Running a specific interpreter is already one command:
# `python3.13 /path/to/jimemo ...`.
_FLOOR = (3, 13, 6)
_LEVELS = {"alpha": "a", "beta": "b", "candidate": "rc"}
_RUNNING = ".".join(str(part) for part in sys.version_info[:3])
if sys.version_info[3] != "final":
    _RUNNING += "{0}{1}".format(
        _LEVELS.get(sys.version_info[3], sys.version_info[3]), sys.version_info[4]
    )
# A PRE-RELEASE is refused whatever its numbers say: CPython 3.14.0b1
# compares (3, 14, 0) >= the floor while its html.parser still fails all
# three checks jimemo depends on, and it let jimemo#y9p8's payload through
# lint clean (measured). A version number cannot say which pre-release
# carries which backport, so jimemo supports final releases only.
if sys.version_info[:3] < _FLOOR or sys.version_info[3] != "final":
    sys.stderr.write(
        "jimemo: error: Python {floor} or newer is required, as a final"
        " release; this interpreter is {running} ({executable}). Install"
        " {floor}+ (macOS: brew install python@3.13; Debian/Ubuntu: apt"
        " install python3.13) and put its python3 first on PATH.\n".format(
            floor=".".join(str(part) for part in _FLOOR),
            running=_RUNNING,
            executable=sys.executable or "unknown",
        )
    )
    raise SystemExit(1)

from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "src"))

from jimemo.cli import main

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
